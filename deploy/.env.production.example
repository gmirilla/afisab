# AFISAB production settings. Copy to /home/USER/afisab/.env on the server and fill in every value.
# Then run:  php artisan key:generate --force   (only the FIRST time; afterwards NEVER change or lose APP_KEY)
# Finally:   php artisan afisab:preflight       (it must report 0 failures before you take real money)

APP_NAME="AFISAB"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_KEY=
APP_TIMEZONE=Africa/Lagos
# cPanel split layout only: the absolute path of your web root (the folder containing index.php and build/).
APP_PUBLIC_PATH=/home/USER/public_html
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database (cPanel: MySQL Databases -> create database + user, give the user ALL privileges) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions, cache, queue (no Redis on shared hosting: use the database) ---
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Mail (verification, password reset, payment and payout emails) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="AFISAB NIG. LTD"

# --- Paystack: use LIVE keys only after testing with test keys ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Where investors send bank transfers (shown on the payment page) ---
# IMPORTANT: any value containing a space MUST be in double quotes (e.g. AFISAB_BANK_NAME="Zenith Bank"),
# otherwise the whole app stops with "The environment file is invalid".
AFISAB_BANK_NAME=""
AFISAB_BANK_ACCOUNT_NUMBER=
AFISAB_BANK_ACCOUNT_NAME="AFISAB NIG. LTD"

# --- Business rules (defaults are the owner's decisions; change only on the owner's instruction) ---
# AFISAB_RISK_RESERVE_BPS=500
# AFISAB_PROFIT_RETENTION_BPS=2000
# AFISAB_INVESTOR_SHARE_BPS=3000
# AFISAB_DISTRIBUTION_CUTOFF_DAY=27
# AFISAB_PURCHASE_DIRECTOR_THRESHOLD=500000000

# Staff must use two-factor authentication. Leave this on.
AFISAB_REQUIRE_2FA=true

BCRYPT_ROUNDS=12
